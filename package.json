{
  "name": "torrent-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Pick shows and movies, fetch them by torrent from vetted legal sources, auto-follow new episodes. Runs in the browser or as a desktop app.",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "npm run build && tsc -p electron/tsconfig.json && cp electron/preload.cjs dist-electron/",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "android": "npm run build && cap sync android && cap open android",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "author": "David Rowell",
  "repository": "github:davidrowell11/torrent-tv"
}
